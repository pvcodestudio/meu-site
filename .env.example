# Copie este arquivo para .env na pasta raiz do projeto.
PORT=3000
NODE_ENV=development
TRUST_PROXY=0
APP_ORIGIN=http://localhost:3000

# MySQL criado no hPanel. Nunca coloque estes dados em public/.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Para conexão remota: TLS é obrigatório; CA personalizada, se fornecida pelo provedor.
DB_SSL_CA=

# Execute npm run admin:credentials no seu terminal para gerar os dois valores.
# Preserve a chave de criptografia quando atualizar o site ou trocar a senha.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
DATA_ENCRYPTION_KEY=
PRIVACY_EMAIL=

# E-mail de saída (exemplo com SMTP do Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=SUA_SENHA_DE_APLICATIVO
MAIL_FROM=seuemail@gmail.com
# Destinatário inicial, depois configurável no painel.
MAIL_TO=
